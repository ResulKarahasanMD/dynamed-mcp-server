# EBSCO developer portalindan alinan OAuth 2.0 client credentials
# https://developer.ebsco.com/ -> hesap olustur -> client app kaydet
EBSCO_CLIENT_ID=your_client_id_here
EBSCO_CLIENT_SECRET=your_client_secret_here

# Hangi urune abone oldugunuza gore: "dynamed" veya "dynamedex"
# dynamedex = DynaMed + Micromedex birlesik icerik
DYNAMED_PRODUCT=dynamed
